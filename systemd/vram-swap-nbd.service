[Unit]
Description=VRAM Swap via NBD (CUDA memcpy backend)
# Start after the display manager so the GUI initialises the NVIDIA GPU (PRIME
# offload) and claims its VRAM first. Grabbing VRAM before that on a cold boot can
# starve Xorg and crash it, leaving a blinking cursor. (Ignored if no display-manager.)
After=systemd-modules-load.service nvidia-persistenced.service display-manager.service
Wants=nvidia-persistenced.service

[Service]
Type=notify
NotifyAccess=main

# VRAM to allocate for swap. Leave headroom for the GPU's own use.
# RTX 3070 (8GB): 7168 leaves ~1GB for display/compute.
Environment=VRAM_SETUP_SIZE_MB=7168
Environment=VRAM_SWAP_PRIORITY=1500
# Keep GPU/CPU contention low when this GPU also drives the desktop.
Environment=VRAM_NBD_THREADS=2
Environment=VRAM_NBD_CONNECTIONS=2
# CPU wait policy: blocking (default) sleeps until GPU work finishes; auto lets CUDA choose and may busy-wait, using more CPU.
Environment=VRAM_CUDA_SCHED=blocking
# Compression: off, lz4, zstd, or zstd:LEVEL (1-22).
# zstd defaults to level 3. Needs liblz4.so.1 or libzstd.so.1 for the chosen codec.
Environment=VRAM_COMPRESS=off
# Share identical pages with reference counting. Independent of compression.
# Dedup adds RAM and verification overhead; write commits are serialized.
Environment=VRAM_DEDUP=0
# Logical swap size / physical VRAM when compression or dedup is enabled (1.0-8.0, default 2.0).
Environment=VRAM_COMPRESS_RATIO=2.0

# Wake GPU before CUDA init to avoid GSP RPC timeout (Xid 119 on laptops)
ExecStartPre=/usr/bin/nvidia-smi -pm 1
# Keep 512 MiB of free-memory headroom for userspace swap I/O.
# Reset on stop by nbd-vram-disconnect.sh.
# TBD testing (provisional): trial 100 instead of 200 to reduce preference for
# swapping application pages over reclaiming file cache. Validate responsiveness
# and memory pressure under load before settling on this value.
# ExecStartPre=/sbin/sysctl -w vm.swappiness=200 vm.min_free_kbytes=524288
ExecStartPre=/sbin/sysctl -w vm.swappiness=100 vm.min_free_kbytes=524288

ExecStart=/usr/local/bin/nbd-vram
ExecStartPost=/usr/local/bin/nbd-vram-connect.sh
ExecStop=/usr/local/bin/nbd-vram-disconnect.sh

LimitMEMLOCK=infinity
OOMScoreAdjust=-1000

Restart=on-failure
RestartSec=10
TimeoutStartSec=60
# Stop runs swapoff (ExecStop), which migrates every in-use page off the
# device - minutes when GBs are swapped. 15s here killed swapoff mid-flight,
# then the daemon, freeing VRAM that still backed live swap pages; the kernel
# read that as memory corruption and MCE-killed processes up to PID 1. The
# daemon exits promptly once swap detaches, so a long timeout only ever waits
# on real swapoff work.
TimeoutStopSec=1800
# If the stop times out anyway (swapoff stuck/failed), do NOT SIGKILL - a
# killed daemon takes live swap pages with it (same crash). Leave it running
# in drain mode, let the unit fail, retry the stop once RAM frees up.
SendSIGKILL=no
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nbd-vram

[Install]
WantedBy=multi-user.target
